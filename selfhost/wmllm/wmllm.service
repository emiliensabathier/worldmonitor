[Unit]
Description=wmllm : shim OpenAI-compatible devant claude -p pour World Monitor (loopback + bridge docker)
After=docker.service network-online.target
Wants=network-online.target

[Service]
User=wmllm
WorkingDirectory=/home/wmllm/app
EnvironmentFile=/home/wmllm/.env
Environment=HOME=/home/wmllm NODE_ENV=production
ExecStart=/usr/bin/node /home/wmllm/app/server.mjs
Restart=on-failure
RestartSec=20
MemoryMax=900M
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/home/wmllm /tmp
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
