# Test image: dependencies + sources, no build. selfhost/check.sh runs tsc / vitest / node --test
# in it, so the VPS needs no node_modules.
FROM node:24-alpine@sha256:ebfe2f90462722a7a4de65e91990e97fe0d401c70e0e762c5b53302f905ec1c1
WORKDIR /app
ENV npm_config_install_links=true
COPY package.json package-lock.json ./
COPY vendor/braces/ ./vendor/braces/
COPY vendor/stream-json/ ./vendor/stream-json/
RUN npm ci --ignore-scripts
COPY . .
